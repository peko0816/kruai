# KruAI production settings. deploy/init-env.sh copies this to kruai.env and
# fills the two generated secrets; the rest is yours to fill (deploy/README.md).
# Every setting not listed here takes its default (docs/CONFIG_REFERENCE.md).

ENV=prod
LOG_LEVEL=INFO

# ---- infrastructure (compose service names; leave as they are) ----
DATABASE_URL=postgresql+psycopg://kruai:__POSTGRES_PASSWORD__@postgres:5432/kruai
REDIS_URL=redis://redis:6379/0
BOT_API_BASE_URL=http://api:8000
# Written into the database at import: import the pack only after this is set.
PUBLIC_MEDIA_BASE_URL=http://media
OBJECT_STORAGE_ENDPOINT=

# ---- secrets ----
JWT_SECRET=__JWT_SECRET__
# From BotFather.
TELEGRAM_BOT_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ---- providers ----
# Lessons are pre-generated data (R1): the runtime calls no LLM and no TTS.
SCORING_PROVIDER=azure
TTS_PROVIDER=fake
LLM_PROVIDER=fake
ZH_TONE_MODE=derive

# ---- payments: off until a real acquirer is contracted (D-100, D-136) ----
PAYMENTS_ENABLED=false
PAYMENT_PROVIDERS=

# ---- trial ----
# Comma-separated Telegram ids: treated as Basic, with their own cost cap (D-131).
TRIAL_TELEGRAM_IDS=
COST_CAP_TRIAL_USD_CENTS_MONTHLY=500
# Comma-separated Telegram ids allowed to read /admin/costs.
ADMIN_TELEGRAM_IDS=

# ---- unused by this deployment, but required to be present ----
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=
BAKONG_TOKEN=
