# KruAI environment template.
#
# Generated from docs/CONFIG_REFERENCE.md — section numbering below mirrors that
# file so the two can be diffed. Adding a key here without adding it there (and
# to core/config.py Settings) is a PR reject; see CONFIG_REFERENCE.md "新增配置项的流程".
#
# Settings uses extra="forbid": an unknown key in .env fails startup on purpose.
#
# Copy to .env and fill section 9. Everything else ships with a working default.
#   cp .env.example .env

# ============================================================ 1. 运行环境
ENV=dev
LOG_LEVEL=INFO

# Matches docker-compose.yml defaults. Change both together.
DATABASE_URL=postgresql+psycopg://kruai:kruai_dev@localhost:5432/kruai
REDIS_URL=redis://localhost:6379/0

# Object storage is unused while TTS_PROVIDER=fake (no media is uploaded).
# Fill in before running pipeline/import_pack.py against a real bucket.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=kruai-media
PUBLIC_MEDIA_BASE_URL=

# ============================================================ 1b. 鉴权
# initData older than this is refused; the session token expires this fast.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# ============================================================ 2. Provider 选择
# All fake = the CI configuration. The system must run end-to-end like this.
SCORING_PROVIDER=fake
SCORING_FALLBACK_PROVIDERS=
TTS_PROVIDER=fake
LLM_PROVIDER=fake
PAYMENT_PROVIDERS=fake
REALTIME_PROVIDER=fake

# ============================================================ 3. 评分与掌握度  [M0]
# SCORING_PASS_THRESHOLD and ZH_TONE_MODE must be recalibrated once M0-1 reports.
SCORING_PASS_THRESHOLD=60.0
SCORING_MAX_RETRY=3
SCORING_TIMEOUT_MS=8000
MASTERY_DELTA_BASE=40.0
MASTERY_WEIGHT_DRILL=0.6
MASTERY_WEIGHT_VOCAB=0.8
MASTERY_WEIGHT_QA=1.0
MASTERY_HIGH=80.0
MASTERY_LOW=60.0
SM2_EASE_INITIAL=2.5
SM2_EASE_MIN=1.3
SM2_EASE_PENALTY=0.2
ZH_TONE_MODE=auto

# ============================================================ 4. 额度与限制
LIMIT_FREE_DAILY_TASKS=3
LIMIT_FREE_DAILY_ATTEMPTS=10
# 0 = unlimited
LIMIT_BASIC_DAILY_ATTEMPTS=0
LIMIT_PRO_REALTIME_SECONDS_MONTHLY=3600
# [$] hard per-session ceiling, server-enforced disconnect
REALTIME_SESSION_MAX_SECONDS=900
# [$] summarise context beyond this many turns to stop token growth
REALTIME_CONTEXT_SUMMARIZE_AFTER_TURNS=8
QUOTA_RESET_HOUR_LOCAL=0

# ============================================================ 5. 成本护栏  [$]
COST_ALERT_MULTIPLIER=1.5
COST_CAP_FREE_USD_CENTS_MONTHLY=15
COST_CAP_BASIC_USD_CENTS_MONTHLY=45
COST_CAP_PRO_USD_CENTS_MONTHLY=230
# Must stay true in dev and CI: an unledgered external call should raise.
COST_LEDGER_REQUIRED=true

# ============================================================ 5b. 订阅与续费
# Both renewal paths must work; provider.supports_recurring picks which.
SUBSCRIPTION_DEFAULT_RENEWAL_MODE=manual
SUBSCRIPTION_REMINDER_DAYS_BEFORE=3
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_AUTO_CHARGE_RETRY_DAYS=1,3
SUPPORTED_CURRENCIES=USD
DEFAULT_CURRENCY=USD

# ============================================================ 6. 媒体与回退
# Keep false until S2 entry conditions are met (PRD 7.2).
MEDIA_VIDEO_ENABLED=false
MEDIA_VIDEO_MIN_PLAN=pro
MEDIA_CLIENT_VIDEO_TIMEOUT_MS=3000
MEDIA_DEFAULT_DATA_SAVER=false

# ============================================================ 7. 内容管线
# [$] Keep false until S2. Video regeneration costs $1-4/minute.
PIPELINE_WITH_VIDEO=false
PIPELINE_REVIEW_SAMPLE_RATE=0.10
PIPELINE_MIN_SENTENCES_PER_CONCEPT=8
PIPELINE_MIN_SUBSTITUTIONS_PER_CONCEPT=12
PIPELINE_MIN_DIALOGUES_PER_CONCEPT=3
PIPELINE_DEDUP_THRESHOLD=0.9
PIPELINE_MAX_CHARS_HSK1=8
PIPELINE_MAX_CHARS_HSK2=12
PIPELINE_MAX_CHARS_HSK3=18
TTS_SPEAKING_RATE_ZH=0.9
TTS_SPEAKING_RATE_KM=1.0

# ============================================================ 8. 实验（A/B）
EXPERIMENT_EXPLAIN_MEDIA_ENABLED=false
EXPERIMENT_EXPLAIN_MEDIA_SPLIT=0.5

# ============================================================ 9. 密钥
# Never commit real values. Never give these defaults in code.
TELEGRAM_BOT_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh
PAYWAY_BASE_URL=
BAKONG_TOKEN=
JWT_SECRET=
